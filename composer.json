{
  "name": "vilgain/php-backend-interview-task",
  "description": "Vilgain PHP Backend Interview Task",
  "type": "project",
  "require": {
    "php": "^8.4",
    "brick/date-time": "^0.8.1",
    "brick/date-time-doctrine": "^0.5.1",
    "contributte/monolog": "^0.6.0",
    "contributte/psr11-container-interface": "^0.6.0",
    "doctrine/dbal": "^4.4",
    "doctrine/orm": "^3.6",
    "laminas/laminas-diactoros": "^3.8",
    "nette/bootstrap": "^3.2",
    "nette/caching": "^3.4",
    "nette/di": "^3.1",
    "nette/neon": "^3.3",
    "nette/robot-loader": "^4.0",
    "nette/schema": "^1.3",
    "nette/utils": "^4.0",
    "nettrine/cache": "^0.5.0",
    "nettrine/dbal": "^0.10.2",
    "nettrine/orm": "dev-master#06341c59c02c882b3002635f1a0802e741a383a5",
    "ramsey/uuid": "^4.7",
    "robmorgan/phinx": "^0.16",
    "slim/slim": "^4.15",
    "symfony/property-access": "^8.0",
    "symfony/serializer": "^8.0",
    "symfony/type-info": "^8.0",
    "symfony/var-exporter": "^8.0",
    "tracy/tracy": "^2.10",
    "vlucas/phpdotenv": "^5.6",
    "zircote/swagger-php": "^5.7"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "shipmonk/phpstan-rules": "^4.3",
    "slevomat/coding-standard": "^8.26",
    "squizlabs/php_codesniffer": "*"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true,
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/vilgain/messenger"
    }
  ],
  "scripts": {
    "dev": "php -S 0.0.0.0:8000 -t public",
    "test": "vendor/bin/tester -C tests",
    "db:reset": "bash ./scripts/db-reset.sh"
  }
}
